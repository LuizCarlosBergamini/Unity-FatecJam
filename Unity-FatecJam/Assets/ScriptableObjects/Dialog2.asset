  dialogs:
  - entity:
      name: Alma Dourada
      icon: {fileID: -5736546130601685858, guid: 70aa9b0b1d25cc249893d2e23b73c63b, type: 3}
    text: "N\xE3o dividirei jornada com inferiores! Esses plebeus certamente n\xE3o
      ter\xE3o o mesmo destino que minha alma her\xF3ica!"
    duration: 8
  - entity:
      name: Caronte
      icon: {fileID: -372853558253606128, guid: 5269993dccb0b2940b99b239d6bd1cf0, type: 3}
    text: "O cargo que tiveste j\xE1 n\xE3o tem utilidade aqui. Tudo o que um dia
      foi teu neste lugar deixaste de possuir. Cobro o pequeno pre\xE7o de um \xF3bolo
      para lev\xE1-lo adiante, pague, antes que perca o \xFAnico resto que te tens:
      a si mesmo."
    duration: 14
