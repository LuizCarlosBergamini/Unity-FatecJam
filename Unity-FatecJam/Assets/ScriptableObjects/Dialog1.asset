  dialogs:
  - entity:
      name: Alma Vermelha
      icon: {fileID: 4605165697322916099, guid: 8ba338972dad740429b3a60797b2c91b, type: 3}
    text: "Fui tra\xEDdo! Malditos! Eram para eles estarem no meu lugar\u2026 "
    duration: 6
  - entity:
      name: Caronte
      icon: {fileID: -372853558253606128, guid: 5269993dccb0b2940b99b239d6bd1cf0, type: 3}
    text: "O que foi j\xE1 est\xE1 no passado; tua ira agora n\xE3o te ajudar\xE1
      em nada, salvo a tua pr\xF3pria destrui\xE7\xE3o.."
    duration: 8
  - entity:
      name: Caronte
      icon: {fileID: -372853558253606128, guid: 5269993dccb0b2940b99b239d6bd1cf0, type: 3}
    text: "De-me um \xF3bolo e eu te levo desse sofrimento. Deixe-me te acalmar ao
      longo de nossa viagem."
    duration: 8
