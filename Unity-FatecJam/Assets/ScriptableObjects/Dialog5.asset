  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cf48f8c261ec914995bde34c05e50a6, type: 3}
  m_Name: Dialog5
  m_EditorClassIdentifier: 
  entities:
  - name: Caronte
    icon: {fileID: -372853558253606128, guid: 5269993dccb0b2940b99b239d6bd1cf0, type: 3}
  - name: Corvo
    icon: {fileID: 0}
  dialogs:
  - entity:
      name: Corvo
      icon: {fileID: 0}
    text: "Ali est\xE1 o descanso, Caronte tuas correntes n\xE3o te prendem a este
      barco, a este destino. Por que n\xE3o junta-se a eles? Por que n\xE3o atravessar
      essa borda e alcan\xE7ar o teu fim?"
    duration: 10
  - entity:
      name: Caronte
      icon: {fileID: -372853558253606128, guid: 5269993dccb0b2940b99b239d6bd1cf0, type: 3}
    text: "\xC9 certo que, achando-me t\xE3o perto do que todos almejam, sou tomado
      pela tenta\xE7\xE3o; mas basta um instante para lembrar-me de minha fun\xE7\xE3o
      e que nenhum outro Deus conseguiria cumpri-la. Afinal, estou aqui desde antes
      de voc\xEA, Hades, cumprindo o que Nix e \xC9rebo me trouxeram em exist\xEAncia
      para cumprir.\r\n"
    duration: 16
